---
import { getCollection } from 'astro:content';
import QRCode from 'qrcode';
import Base from '../layouts/Base.astro';
import { separarYOrdenar } from '../lib/proyectos';
import { urlAbsoluta } from '../lib/url';

const { competencia, extras } = separarYOrdenar(await getCollection('proyectos'));

const celdas = await Promise.all(
  [...competencia, ...extras].map(async (proyecto) => {
    const destino = urlAbsoluta(`proyectos/${proyecto.id}/`);
    const svg = await QRCode.toString(destino, {
      type: 'svg',
      margin: 1,
      errorCorrectionLevel: 'M',
      color: { dark: '#000000', light: '#ffffff' },
    });
    return { proyecto, destino, svg };
  }),
);
---

<Base titulo="QR" sinChrome>
  <h1 class="titulo-display">QR del stand</h1>
  <p class="aviso">Imprimí esta página en A4, recortá cada QR y pegalo junto a su robot.</p>
  <div class="hoja">
    {
      celdas.map(({ proyecto, destino, svg }) => (
        <div class="celda">
          <div class="qr" set:html={svg} />
          <div class="nombre">
            <span class="titulo-display">{proyecto.data.nombre}</span>
            {proyecto.data.kanji && <span class="kanji" lang="ja">{proyecto.data.kanji}</span>}
          </div>
          <small class="mono">{destino.replace(/^https:\/\//, '')}</small>
        </div>
      ))
    }
  </div>
</Base>

<style>
  h1 {
    font-size: 2.4rem;
    margin: 1.5rem 0 0.25rem;
  }
  .hoja {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin: 1rem 0 2rem;
  }
  @media (min-width: 900px) {
    .hoja {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .celda {
    border: 1.5px dashed var(--tinta);
    border-radius: 8px;
    background: var(--tarjeta);
    padding: 10px;
    text-align: center;
    break-inside: avoid;
  }
  .qr :global(svg) {
    display: block;
    width: 45mm;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
  }
  .nombre {
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: 8px;
    margin-top: 6px;
  }
  .nombre .titulo-display {
    font-size: 1.4rem;
  }
  small {
    display: block;
    font-size: 0.6rem;
    overflow-wrap: anywhere;
  }
  @page {
    size: A4;
    margin: 10mm;
  }
  @media print {
    :global(body) {
      background: #fff !important;
      color: #000 !important;
      min-height: 0;
    }
    :global(main.contenedor) {
      max-width: none;
      padding: 0;
    }
    h1 {
      font-size: 1.6rem;
      margin-top: 0;
    }
    .aviso {
      display: none;
    }
    .hoja {
      grid-template-columns: repeat(3, 1fr);
    }
    .celda {
      background: #fff;
      border-color: #000;
      color: #000;
    }
    .kanji {
      color: #c8102e;
    }
  }
</style>
