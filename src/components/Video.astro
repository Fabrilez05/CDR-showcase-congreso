---
interface Props {
  src: string;
}

const { src } = Astro.props;
---

<video class="video" src={src} controls preload="metadata" playsinline></video>

<style>
  .video {
    display: block;
    width: 100%;
    border: var(--borde);
    border-radius: var(--radio);
    background: #000;
    margin: 1rem 0;
  }
</style>
